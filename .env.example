# Simpatico CRM - Environment Variables Template
# Copy this file to .env for local deployment and fill in target values.
# DO NOT commit real secrets or passwords to version control.

# Spring Active Profile (dev, test, prod)
SPRING_PROFILES_ACTIVE=prod

# Server Network Port
PORT=8080

# Database Configuration (PostgreSQL with SSL/TLS enabled)
SPRING_DATASOURCE_URL=jdbc:postgresql://<production-db-host>:5432/<db-name>?sslmode=require
SPRING_DATASOURCE_USERNAME=simpatico_crm_user
SPRING_DATASOURCE_PASSWORD=<secure-database-password-32-chars+>

# Database HikariCP Connection Pool Settings
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=5
SPRING_DATASOURCE_HIKARI_IDLE_TIMEOUT=300000
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=20000
SPRING_DATASOURCE_HIKARI_MAX_LIFETIME=1800000

# CORS Allowed Origins (Comma-separated list of production domains; NEVER use *)
ALLOWED_ORIGINS=https://simpaticoliquidations.com,https://www.simpaticoliquidations.com

# Rate Limiting Configuration
RATE_LIMITING_ENABLED=true
RATE_LIMITING_LIMIT=10
